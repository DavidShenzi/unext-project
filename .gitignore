# ---------------------------------------------------------------- data
# BUSI must be downloaded from its original source (registration required);
# redistributing it here would be both a licence problem and a 460 MB commit.
Dataset_BUSI.zip
raw/
unext/inputs/

# ---------------------------------------------------------------- weights
# 262 MB of checkpoints. Every result they support is reproducible from
# models/*/log.csv + config.yml, which ARE committed (738 KB total).
# If a trained model is needed, share it via Drive, not git.
*.pth
*.pt
*.ckpt

# ---------------------------------------------------------------- raw stdout
# 53 MB, almost all of it tqdm progress-bar spam ("12%|#2 | 1/8 ..." repeated
# thousands of times). The per-epoch metrics are in models/*/log.csv instead.
unext/train_*.log
unext/_bench_*.log

# ---------------------------------------------------------------- predicted masks
# Regenerate with: python val.py --name <run>
unext/outputs/

# ---------------------------------------------------------------- upstream clone
# Reference only; clone it yourself:
#   git clone https://github.com/jeya-maria-jose/UNeXt-pytorch
unext_upstream/

# ---------------------------------------------------------------- python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---------------------------------------------------------------- office / os
~$*
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- editors
.vscode/
.idea/
*.swp

# paper PDF - linked in README instead of redistributed
2203.04967v1.pdf

# ---------------------------------------------------------------- course material
# The assignment brief is the lecturers' document, not our work product.
Deep Learning*.pdf

# ---------------------------------------------------------------- assistant / tooling notes
# Working notes from editors and coding assistants; not part of the submission.
.claude/
CLAUDE.md
.aider*
.cursor/
.continue/

# ---------------------------------------------------------------- scratch
scratchpad/
tmp/
*.tmp
*.bak
*.orig
*.new.pptx
nohup.out

# ---------------------------------------------------------------- personal data
# The course requires ID numbers on the submitted presentation, but this repo is
# public. *_SUBMIT.pptx holds the version WITH IDs and must never be committed;
# the committed deck carries names only.
*_SUBMIT.pptx

# ---------------------------------------------------------------- speaker notes
# Working material, not a deliverable: rehearsal phrasing, planned answers to
# questions, and candid notes about our own mistakes. None of it goes to a public
# repo or to the course.
#
#   *_NOTES.pptx          the presenting copy, with notes in the notes pane
#   UNeXt_speaker_notes*  the standalone notes decks (English and Hebrew)
#   make_pptx.py          the generators embed that same note text as source
#   make_speaker_pptx*.py
#
# The committed UNeXt_presentation.pptx is produced by strip_notes.py, which removes
# the notesSlide parts entirely rather than blanking them, and verifies the result.
*_NOTES.pptx
UNeXt_speaker_notes.pptx
UNeXt_speaker_notes_HE.pptx
unext/make_pptx.py
unext/make_speaker_pptx.py
unext/make_speaker_pptx_he.py

# The slide-planning outline: it assigns who presents which slide and duplicates the
# deck's content, and it goes stale every time the deck changes. Kept locally as
# presentation_outline_LOCAL.md.
presentation_outline.md
*_LOCAL.md

# queue logs from unattended runs (regenerable; models/ already ignored)
unext/queue_logs/
